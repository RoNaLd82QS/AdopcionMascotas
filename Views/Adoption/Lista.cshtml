@model List<SistemaAdopcionMascotas.Models.Adoption>

@{
    ViewData["Title"] = "Lista de Adopciones";
}

<h2>Lista de Adopciones</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mascota</th>
            <th>Tipo</th>
            <th>Adoptante</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var adopcion in Model)
    {
        <tr>
            <td>@adopcion.Pet?.Nombre</td>
            <td>@adopcion.Pet?.Tipo</td>
            <td>@adopcion.Adopter?.Nombre</td>
            <td>@adopcion.Pet?.Estado</td>
        </tr>
    }
    </tbody>
</table>
