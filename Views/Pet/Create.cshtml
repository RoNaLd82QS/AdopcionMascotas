@model SistemaAdopcionMascotas.Models.Pet

@{
    ViewData["Title"] = "Registrar Mascota";
}

<h2>Registrar Mascota</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Edad"></label>
        <input asp-for="Edad" type="number" class="form-control" required min="0" />
    </div>

    <div class="form-group">
        <label asp-for="Tipo"></label>
        <input asp-for="Tipo" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Estado"></label>
        <select asp-for="Estado" class="form-control">
            <option value="disponible">Disponible</option>
            <option value="adoptada">Adoptada</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
</form>
